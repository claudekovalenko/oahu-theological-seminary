# ---- Optional: Supabase (accounts, saved progress, application storage) ----
# Create a project at https://supabase.com, run supabase/migrations/0001_init.sql,
# then copy the values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional: forward applications to a webhook (Zapier, Make, Formspree, etc.) ----
APPLICATION_WEBHOOK_URL=

# ---- Optional: Moodle ----
# When set, a "Moodle" tab appears in the student portal with an embedded frame.
NEXT_PUBLIC_MOODLE_URL=
